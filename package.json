{
  "name": "korikone",
  "version": "0.1.0",
  "private": true,
  "description": "Local meal planning and reviewed grocery baskets",
  "author": "Vkuparin",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && node scripts/build-main.mjs",
    "start": "electron .",
    "pretest": "node scripts/build-main.mjs",
    "test": "vitest run",
    "test:ui": "playwright test",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src tests scripts *.json *.ts *.html",
    "format:check": "prettier --check src tests scripts *.json *.ts *.html",
    "package": "npm run prepare:worker && npm run notices && npm run build && electron-builder --win nsis --x64",
    "prepare:worker": "node scripts/prepare-worker.mjs",
    "notices": "node scripts/notices.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "jose": "6.2.12",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "prettier": "3.9.9",
    "typescript": "7.0.2",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  },
  "build": {
    "appId": "fi.korikone.desktop",
    "productName": "Korikone",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json",
      "LICENSE",
      "THIRD_PARTY_NOTICES.txt"
    ],
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "extraResources": [
      {
        "to": "vendor/k-ruoka",
        "filter": [
          "k-ruoka-mcp.exe",
          "LICENSE"
        ],
        "from": "vendor/k-ruoka"
      }
    ]
  }
}
